rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function validUniqueKeyType(keyType) {
      return keyType in ['nickname', 'email', 'phone'];
    }

    function keyPathFor(type, value) {
      return /databases/$(database)/documents/unique_user_keys/$(type + ':' + value);
    }

    /** Operación + cuenta con rol persistido `users/{uid}.role`. */
    function isSuperAdmin() {
      return isSignedIn()
        && (
          request.auth.token.email == 'pochobs@gmail.com'
          || (
            exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin'
          )
        );
    }

    /** Subcolección genérica usuario: sin pisar `/notifications`, `/crypto/`. */
    function userGenericRead(uid, tail) {
      return isOwner(uid)
        && !tail.matches('^notifications(?:/.*)?$')
        && !tail.matches('^crypto(?:/.*)?$');
    }

    /** Sin `/notifications`, `/crypto/` ni `/status/` (salvo estado de broadcasts). */
    function userGenericWrite(uid, tail) {
      let statusLocked =
        tail.matches('^status/.*')
        && !(tail == 'status/notifications_state' || tail.matches('^status/notifications_state/.*'));

      return isOwner(uid)
        && !tail.matches('^notifications(?:/.*)?$')
        && !tail.matches('^crypto(?:/.*)?$')
        && !statusLocked;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isSuperAdmin();

      allow create, update: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.nicknameLower is string
        && request.resource.data.emailLower is string
        && request.resource.data.phoneNormalized is string
        && getAfter(keyPathFor('nickname', request.resource.data.nicknameLower)).data.uid == uid
        && getAfter(keyPathFor('email', request.resource.data.emailLower)).data.uid == uid
        && getAfter(keyPathFor('phone', request.resource.data.phoneNormalized)).data.uid == uid;

      allow delete: if false;
    }

    match /users/{uid}/links/{linkId} {
      allow read: if isOwner(uid) || isSuperAdmin();
      allow create, update: if isOwner(uid);
      allow delete: if isOwner(uid) || isSuperAdmin();
    }

    match /users/{uid}/notifications/{notificationId} {
      allow read: if isOwner(uid);

      allow create: if request.resource.data.read == false
        && (
          (
            isSuperAdmin()
            && request.resource.data.templateId in ['MOD_REPORT_APPROVED', 'MOD_REPORT_REJECTED']
            && request.resource.data.reportId is string
            && request.resource.data.reportSourceCollection in ['reports', 'userReports']
          )
          ||
          (
            isOwner(uid)
            && request.resource.data.templateId in ['SYS_WELCOME_MISSING_CARD', 'SYS_ACCOUNT_EXPIRING', 'SYS_ONBOARDING_TOUR']
          )
        );

      allow update, delete: if isOwner(uid);
    }

    match /users/{uid}/icon_vault/{itemId} {
      allow read: if isOwner(uid) || isSuperAdmin();
      allow write: if isOwner(uid);
    }

    match /users/{uid}/vault/{itemId} {
      allow read: if isOwner(uid) || isSuperAdmin();
      allow write: if isOwner(uid);
    }

    match /users/{uid}/legalConsentEvents/{eventId} {
      allow read: if isOwner(uid) || isSuperAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.eventType == 'LEGAL_CONSENT_ACCEPTED'
        && request.resource.data.legalConsentBundleVersion is string
        && request.resource.data.acceptedDocuments is map
        && request.resource.data.hashAlgorithm == 'SHA-256'
        && request.resource.data.canonicalization == 'json-stable-v1'
        && request.resource.data.termsHash is string
        && request.resource.data.privacyHash is string
        && request.resource.data.usageHash is string
        && request.resource.data.bundleHash is string
        && request.resource.data.legalTextSnapshot is map;
      allow update, delete: if false;
    }

    match /users/{uid}/private_app_state/{document=**} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/crypto/sharing_identity {
      allow read: if isSignedIn();
      allow write: if isOwner(uid);
    }

    match /users/{uid}/status/notifications_state {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['readBroadcastIds'])
        && request.resource.data.readBroadcastIds is list
        && request.resource.data.readBroadcastIds.size() <= 2000;
      allow delete: if false;
    }

    match /users/{uid}/status/{docId} {
      allow read: if isOwner(uid) || isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    match /users/{uid}/{document=**} {
      allow read: if userGenericRead(uid, document);
      allow write: if userGenericWrite(uid, document);
    }

    match /unique_user_keys/{keyId} {
      allow get: if isSignedIn();
      allow list: if false;

      allow create, update: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type is string
        && request.resource.data.value is string
        && validUniqueKeyType(request.resource.data.type)
        && (
          (request.resource.data.type == 'nickname' && keyId.matches('^nickname:.+$'))
          ||
          (request.resource.data.type == 'email' && keyId.matches('^email:.+$'))
          ||
          (request.resource.data.type == 'phone' && keyId.matches('^phone:.+$'))
        )
        && (
          !exists(/databases/$(database)/documents/unique_user_keys/$(keyId))
          ||
          get(/databases/$(database)/documents/unique_user_keys/$(keyId)).data.uid == request.auth.uid
        );

      allow delete: if false;
    }

    match /shared_vault_keys/{keyId} {
      allow read: if isSignedIn()
        && (
          resource.data.toUid == request.auth.uid
          || resource.data.fromUid == request.auth.uid
        );

      allow create: if isSignedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.scheme == 'x25519-hkdf-aesgcm-v1'
        && request.resource.data.envelope is map
        && request.resource.data.envelope.v == 1
        && request.resource.data.envelope.scheme == 'x25519-hkdf-aesgcm-v1'
        && request.resource.data.envelope.ephemPubB64 is string
        && request.resource.data.envelope.saltB64 is string
        && request.resource.data.envelope.ivB64 is string
        && request.resource.data.envelope.ctB64 is string;

      allow update, delete: if false;
    }

    match /businessCards/{bId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isSignedIn()
        && (resource.data.uid == request.auth.uid || isSuperAdmin());
    }

    match /icon_packs/{packId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSuperAdmin();
    }

    match /skins/{skinId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSuperAdmin();
    }

    /** Catálogos mercado/app (Firestore). */
    match /font_library/{id} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /wallpapers/{id} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    /** Inventario Studio (admin-web). `icon_packs`/`skins` se reutilizan arriba. */
    match /wallpaper_library/{id} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /icon_library/{id} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /studio_themes/{id} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /studio_icon_packs/{id} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /studio_skins/{id} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /admin/accountRecoveryTickets/tickets/{ticketId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isSuperAdmin();
    }

    match /admin/{document=**} {
      allow read, write: if isSuperAdmin();
    }

    match /ghostLinkVoipSignals/{sessionId} {
      allow read, write: if isSignedIn();
    }

    match /referrals/{referredUid} {
      allow read: if isSignedIn()
        && (
          resource.data.referrerUid == request.auth.uid
          || resource.data.referredUid == request.auth.uid
          || isSuperAdmin()
        );

      allow create: if isSignedIn()
        && referredUid == request.auth.uid
        && request.resource.data.referredUid == request.auth.uid
        && request.resource.data.referrerUid is string
        && request.resource.data.referrerUid != request.auth.uid
        && request.resource.data.status == 'completed';

      allow update: if isSignedIn()
        && referredUid == request.auth.uid
        && resource.data.referredUid == request.auth.uid
        && request.resource.data.referredUid == resource.data.referredUid
        && resource.data.referrerUid == request.resource.data.referrerUid
        && resource.data.status == 'completed'
        && request.resource.data.status == 'completed';

      allow delete: if false;
    }

    match /medals/{medalDocId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /medals/{medalDocId}/votes/{userId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isOwner(userId);
    }

    match /system_config/{docId} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin();
    }

    match /reports/{reportId} {
      allow read: if isSuperAdmin();

      allow create: if isSignedIn()
        && request.resource.data.reporterUserId == request.auth.uid
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time + duration.value(34, 'h')
        && request.resource.data.expiresAt < request.time + duration.value(38, 'h')
        && request.resource.data.evidenceVersion == 1
        && request.resource.data.evidenceStatus in ['present', 'missing', 'invalid']
        && request.resource.data.evidenceCiphertext is string
        && request.resource.data.evidenceIv is string
        && request.resource.data.evidenceEphemPub is string
        && (
          request.resource.data.evidenceStatus != 'present'
          || (
            request.resource.data.evidenceCiphertext.size() > 32
            && request.resource.data.evidenceIv.size() > 0
            && request.resource.data.evidenceEphemPub.size() > 0
          )
        )
        && request.resource.data.type is string
        && request.resource.data.status == 'pending'
        && request.resource.data.targetCardId is string
        && request.resource.data.reportedUserId is string
        && request.resource.data.reason is string
        && request.resource.data.details is string
        && request.resource.data.anonymous == true
        && request.resource.data.source == 'medal_rating_modal';

      allow update, delete: if isSuperAdmin();
    }

    match /userReports/{reportId} {
      allow read, create, update, delete: if isSuperAdmin();
    }

    /** Auditoría moderación (`reports` y `userReports`). */
    match /{reportColl}/{reportId}/auditLog/{eventId} {
      allow read, write: if isSuperAdmin()
        && reportColl in ['reports', 'userReports'];
    }

    match /banned_identities/{uid} {
      allow read, write: if isSuperAdmin();
    }

    match /system_broadcasts/{broadcastId} {
      allow read: if isSignedIn();
      allow create: if isSuperAdmin()
        && request.resource.data.templateId is string
        && request.resource.data.isActive is bool;
      allow update, delete: if isSuperAdmin();
    }

    /** Regalo QR (`services/qrGiftService`): el id es el secreto del enlace. */
    match /qr_gifts/{giftId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid;
      /** Canje cliente: actualiza uso; revisar eventualmente si movéis la lógica a Functions. */
      allow update: if isSignedIn();
      allow delete: if isSuperAdmin();
    }

    match /vip_campaigns/{id} {
      allow read: if isSignedIn();
      allow create, delete: if isSuperAdmin();
      allow update: if isSignedIn();
    }

    match /redemption_logs/{id} {
      allow read: if isSuperAdmin();
      allow create: if isSignedIn()
        && request.resource.data.redeemedBy == request.auth.uid;
      allow update, delete: if false;
    }

    /** Escrituras QR campañas desde cliente con `actor` = uid. Lectura sólo admin. */
    match /admin_audit/{id} {
      allow read: if isSuperAdmin();
      allow create: if isSignedIn()
        && request.resource.data.actor == request.auth.uid;
      allow update, delete: if false;
    }

    match /pricing_audit_logs/{id} {
      allow read, write: if isSuperAdmin();
    }

    match /legal_audit_logs/{id} {
      allow read, write: if isSuperAdmin();
    }

    match /market_radar_audit_logs/{id} {
      allow read, write: if isSuperAdmin();
    }

    match /payment_events/{id} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /organizations/{id} {
      allow read, write: if isSuperAdmin();
    }

    match /affiliates/{id} {
      allow read, write: if isSuperAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
