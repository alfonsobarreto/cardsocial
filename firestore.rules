rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function validUniqueKeyType(keyType) {
      return keyType in ['nickname', 'email', 'phone'];
    }

    function keyPathFor(type, value) {
      return /databases/$(database)/documents/unique_user_keys/$(type + ':' + value);
    }

    function isSuperAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin';
    }

    // User profile: owner read/write; super_admin read (dashboard).
    // Enforces that unique key docs belong to same uid in the post-transaction state.
    match /users/{uid} {
      allow read: if isOwner(uid) || isSuperAdmin();

      allow create, update: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.nicknameLower is string
        && request.resource.data.emailLower is string
        && request.resource.data.phoneNormalized is string
        && getAfter(keyPathFor('nickname', request.resource.data.nicknameLower)).data.uid == uid
        && getAfter(keyPathFor('email', request.resource.data.emailLower)).data.uid == uid
        && getAfter(keyPathFor('phone', request.resource.data.phoneNormalized)).data.uid == uid;

      allow delete: if false;
    }

    // Links de bóveda: el superadmin puede borrar tarjetas confirmadas por moderación.
    match /users/{uid}/links/{linkId} {
      allow read: if isOwner(uid) || isSuperAdmin();
      allow create, update: if isOwner(uid);
      allow delete: if isOwner(uid) || isSuperAdmin();
    }

    // Notificaciones oficiales: super_admin crea cierres MOD_*; el dueño puede crear SYS_* (sistema in-app); lectura/actualización solo dueño.
    match /users/{uid}/notifications/{notificationId} {
      allow read: if isOwner(uid);
      allow create: if request.resource.data.read == false
        && (
          (
            isSuperAdmin()
            && request.resource.data.templateId in ['MOD_REPORT_APPROVED', 'MOD_REPORT_REJECTED']
            && request.resource.data.reportId is string
            && request.resource.data.reportSourceCollection in ['reports', 'userReports']
          )
          || (
            isOwner(uid)
            && request.resource.data.templateId in ['SYS_WELCOME_MISSING_CARD', 'SYS_ACCOUNT_EXPIRING', 'SYS_ONBOARDING_TOUR']
          )
        );
      allow update: if isOwner(uid);
      allow delete: if isOwner(uid);
    }

    // Onboarding / tour in-app: flags y notas bajo rutas explícitas (dueño). Complementa el
    // match recursivo general; algunos clientes disparan lecturas justo tras login.
    match /users/{uid}/private_app_state/{document=**} {
      allow read, write: if isOwner(uid);
    }

    // Dueño: lectura/escritura en subcolección notifications (incl. queries y batch).
    // super_admin crea MOD_* vía la regla granular anterior cuando auth.uid != uid (no es dueño del doc).
    match /users/{uid}/notifications/{document=**} {
      allow read, write: if isOwner(uid);
    }

    // Bóveda e iconos: dueño o moderación (panel admin) solo lectura.
    match /users/{uid}/icon_vault/{itemId} {
      allow read: if isOwner(uid) || isSuperAdmin();
      allow write: if isOwner(uid);
    }

    match /users/{uid}/vault/{itemId} {
      allow read: if isOwner(uid) || isSuperAdmin();
      allow write: if isOwner(uid);
    }

    // Owner-only access for all user-scoped subcollections
    match /users/{uid}/{document=**} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid);
    }

    // Identidad X25519 para compartir llaves de tarjeta: lectura a cualquier usuario autenticado;
    // solo el dueño escribe (documento bajo users/{uid}/crypto/…).
    match /users/{uid}/crypto/sharing_identity {
      allow read: if isSignedIn();
      allow write: if isOwner(uid);
    }

    // Estado de notificaciones in-app por usuario (megáfono leído): solo el dueño escribe readBroadcastIds.
    match /users/{uid}/status/notifications_state {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['readBroadcastIds'])
        && request.resource.data.readBroadcastIds is list
        && request.resource.data.readBroadcastIds.size() <= 2000;
      allow delete: if false;
    }

    // Estado de cuenta por moderación (super_admin): auditoría separada del doc raíz `users/{uid}`.
    match /users/{uid}/status/{docId} {
      allow read: if isOwner(uid) || isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // Cabina de sobres cifrados: el remitente crea; remitente o destinatario lee.
    // `envelope` contiene ephemPub, salt, iv, ciphertext (AES-GCM); Firestore no ve el plaintext.
    match /shared_vault_keys/{keyId} {
      allow read: if isSignedIn()
        && (
          resource.data.toUid == request.auth.uid
          || resource.data.fromUid == request.auth.uid
        );

      allow create: if isSignedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.scheme == 'x25519-hkdf-aesgcm-v1'
        && request.resource.data.envelope is map
        && request.resource.data.envelope.v == 1
        && request.resource.data.envelope.scheme == 'x25519-hkdf-aesgcm-v1'
        && request.resource.data.envelope.ephemPubB64 is string
        && request.resource.data.envelope.saltB64 is string
        && request.resource.data.envelope.ivB64 is string
        && request.resource.data.envelope.ctB64 is string;

      allow update, delete: if false;
    }

    // Unique-key registry (nickname/email/phone) used by transactional registration.
    match /unique_user_keys/{keyId} {
      allow read: if false;

      allow create, update: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type is string
        && request.resource.data.value is string
        && validUniqueKeyType(request.resource.data.type)
        && (
          (request.resource.data.type == 'nickname' && keyId.matches('^nickname:.+$')) ||
          (request.resource.data.type == 'email' && keyId.matches('^email:.+$')) ||
          (request.resource.data.type == 'phone' && keyId.matches('^phone:.+$'))
        )
        // If key already exists, only same owner can keep/update it.
        && (!exists(/databases/$(database)/documents/unique_user_keys/$(keyId))
          || get(/databases/$(database)/documents/unique_user_keys/$(keyId)).data.uid == request.auth.uid);

      allow delete: if false;
    }

    // Business cards can be queried by authenticated users for Social Market.
    // Only owner or super admin can write.
    match /businessCards/{bId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;

      allow update, delete: if isSignedIn()
        && (
          resource.data.uid == request.auth.uid
          || isSuperAdmin()
        );
    }

    // Icon catalog: readable for signed-in users, mutable only by super admin.
    match /icon_packs/{packId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSuperAdmin();
    }

    // Skins forjados desde La Forja admin (wallpaper Spaces + icon pack + colores).
    match /skins/{skinId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSuperAdmin();
    }

    // Admin namespace restricted to super admin, except recovery ticket creation by any authenticated user.
    match /admin/accountRecoveryTickets/tickets/{ticketId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isSuperAdmin();
    }

    match /admin/{document=**} {
      allow read, write: if isSuperAdmin();
    }

    // Ghost-Link VoIP: señales efímeras de consentimiento cámara (audio → video).
    // sessionId opaco por llamada; solo usuarios autenticados (riesgo bajo si no adivinan el id).
    match /ghostLinkVoipSignals/{sessionId} {
      allow read, write: if isSignedIn();
    }

    // Referidos únicos por usuario nuevo: solo el cuenta creador (`referredUid`) puede crear su doc `{referrerUid,...}`.
    match /referrals/{referredUid} {
      allow read: if isSignedIn()
        && (
          resource.data.referrerUid == request.auth.uid
          || resource.data.referredUid == request.auth.uid
          || isSuperAdmin()
        );

      allow create: if isSignedIn()
        && referredUid == request.auth.uid
        && request.resource.data.referredUid == request.auth.uid
        && request.resource.data.referrerUid is string
        && request.resource.data.referrerUid != request.auth.uid
        && request.resource.data.status == 'completed';

      /** `setDoc(merge)` en doc existente cuenta como actualización — solo permite refrescar mismo referidor. */
      allow update: if isSignedIn()
        && referredUid == request.auth.uid
        && resource.data.referredUid == request.auth.uid
        && request.resource.data.referredUid == resource.data.referredUid
        && resource.data.referrerUid == request.resource.data.referrerUid
        && resource.data.status == 'completed'
        && request.resource.data.status == 'completed';

      allow delete: if false;
    }

    // Medal system: counts readable by all signed-in users; votes owner-only.
    match /medals/{medalDocId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /medals/{medalDocId}/votes/{userId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isOwner(userId);
    }

    // Config pública de producto (tiers, precios CMS). Lectura pública de docs publicados; solo super_admin escribe.
    match /system_config/{docId} {
      allow read: if docId in ['tiers', 'commerce', 'market_radar', 'cs_economy'] || isSignedIn();
      allow create, update, delete: if isSuperAdmin();
    }

    // Denuncias: creación autenticada con sobre de evidencia o estado explícito; lectura solo super_admin (evidence* no filtrable por campo).
    function validReportExpiresAt() {
      return request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time + duration.value(34, 'h')
        && request.resource.data.expiresAt < request.time + duration.value(38, 'h');
    }

    function validReportEvidenceShape() {
      return request.resource.data.evidenceVersion == 1
        && request.resource.data.evidenceStatus in ['present', 'missing', 'invalid']
        && request.resource.data.evidenceCiphertext is string
        && request.resource.data.evidenceIv is string
        && request.resource.data.evidenceEphemPub is string
        && (
          request.resource.data.evidenceStatus != 'present'
          || (
            request.resource.data.evidenceCiphertext.size() > 32
            && request.resource.data.evidenceIv.size() > 0
            && request.resource.data.evidenceEphemPub.size() > 0
          )
        );
    }

    match /reports/{reportId} {
      allow read: if isSuperAdmin();

      allow create: if isSignedIn()
        && request.resource.data.reporterUserId == request.auth.uid
        && validReportExpiresAt()
        && validReportEvidenceShape()
        && request.resource.data.type is string
        && request.resource.data.status == 'pending'
        && request.resource.data.targetCardId is string
        && request.resource.data.reportedUserId is string
        && request.resource.data.reason is string
        && request.resource.data.details is string
        && request.resource.data.anonymous == true
        && request.resource.data.source == 'medal_rating_modal';

      allow update, delete: if isSuperAdmin();
    }

    match /userReports/{reportId} {
      allow read: if isSuperAdmin();
      allow create, update, delete: if isSuperAdmin();
    }

    match /reports/{reportId}/auditLog/{eventId} {
      allow read, write: if isSuperAdmin();
    }

    match /userReports/{reportId}/auditLog/{eventId} {
      allow read, write: if isSuperAdmin();
    }

    match /banned_identities/{uid} {
      allow read, write: if isSuperAdmin();
    }

    // Megáfono global in-app: un documento por anuncio; lectura a usuarios logueados; escritura solo super_admin.
    match /system_broadcasts/{broadcastId} {
      allow read: if isSignedIn();
      allow create: if isSuperAdmin()
        && request.resource.data.templateId is string
        && request.resource.data.isActive is bool;
      allow update, delete: if isSuperAdmin();
    }

    // Default deny for any non-explicit collection.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
