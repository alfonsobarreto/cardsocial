{
  "expo": {
    "name": "card-social",
    "slug": "card-social",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/CS Icon Logo.png",
    "scheme": "cardsocial",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/CS Icon Logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "deepLinks": [
      "cardsocial://",
      "cardsocial://redeem",
      "cardsocial://redeem?code=*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cardsocial.app",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "googlegmail",
          "ms-outlook",
          "ymail",
          "googlegmail",
          "ms-outlook",
          "ymail"
        ],
        "NSMicrophoneUsageDescription": "Card-Social usa el micrófono para las llamadas de voz Ghost-Link (VoIP).",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/CS Icon Logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.cardsocial.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-video",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Card-Social usa tu ubicación cuando buscas en el mercado o cuando guardas la ubicación de tu tarjeta de negocio; no hay rastreo continuo en segundo plano."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "63df0a01-75f5-40bf-96be-2fdfde55c77f"
      }
    }
  }
}
