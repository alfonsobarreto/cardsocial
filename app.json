{
  "expo": {
    "name": "card-social",
    "slug": "card-social",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "cardsocial",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/cs-app-icon-ios.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "deepLinks": [
      "cardsocial://",
      "cardsocial://redeem",
      "cardsocial://redeem?code=*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cardsocial.app",
      "associatedDomains": [
        "applinks:cardsocial.me"
      ],
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "googlegmail",
          "instagram",
          "linkedin",
          "ms-outlook",
          "twitter",
          "vnd.youtube",
          "youtube",
          "whatsapp",
          "ymail"
        ],
        "NSMicrophoneUsageDescription": "Card-Social usa el micrófono para las llamadas de voz Ghost-Link (VoIP).",
        "NSCameraUsageDescription": "Card-Social usa la cámara para videollamadas FaceCall Ghost-Link.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio",
          "voip"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true,
          "NSExceptionDomains": {
            "localhost": {
              "NSTemporaryExceptionAllowsInsecureHTTPLoads": true
            }
          }
        }
      }
    },
    "android": {
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.cardsocial.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "cardsocial.me",
              "pathPrefix": "/u"
            },
            {
              "scheme": "https",
              "host": "cardsocial.me",
              "pathPrefix": "/b"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.WAKE_LOCK",
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-av",
      [
        "expo-camera",
        {
          "cameraPermission": "Card-Social usa la cámara para videollamadas FaceCall Ghost-Link.",
          "microphonePermission": "Card-Social usa el micrófono para llamadas Ghost-Link y FaceCall."
        }
      ],
      "expo-video",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Card-Social usa tu ubicación cuando buscas en el mercado o cuando guardas la ubicación de tu tarjeta de negocio; no hay rastreo continuo en segundo plano."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/cs-icon-logo.png",
          "color": "#C5A065",
          "defaultChannel": "ghost-link-calls",
          "sounds": []
        }
      ],
      [
        "react-native-permissions/app.plugin.js",
        {
          "iosPermissions": [
            "Camera"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "63df0a01-75f5-40bf-96be-2fdfde55c77f"
      }
    }
  }
}
