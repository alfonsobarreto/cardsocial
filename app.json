{
  "expo": {
    "name": "card-social",
    "slug": "card-social",
    "version": "1.0.14",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "cardsocial",
    "userInterfaceStyle": "automatic",
    "androidStatusBar": {
      "translucent": true,
      "backgroundColor": "#00000000",
      "barStyle": "dark-content"
    },
    "splash": {
      "image": "./assets/images/cs-app-icon-ios.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "buildNumber": "17",
      "supportsTablet": true,
      "bundleIdentifier": "com.cardsocial.app",
      "associatedDomains": [
        "applinks:cardsocial.me"
      ],
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "http",
          "https",
          "googlegmail",
          "instagram",
          "linkedin",
          "ms-outlook",
          "twitter",
          "vnd.youtube",
          "youtube",
          "whatsapp",
          "ymail"
        ],
        "NSMicrophoneUsageDescription": "Card-Social usa el micrófono para las llamadas de voz Ghost-Link (VoIP).",
        "NSCameraUsageDescription": "Card-Social usa la cámara para tu foto de perfil, la selfie de verificación y las videollamadas FaceCall Ghost-Link.",
        "NSPhotoLibraryUsageDescription": "Card-Social accede a tu galería para que puedas elegir la foto de perfil u otros archivos durante el registro.",
        "NSLocationWhenInUseUsageDescription": "Card-Social usa tu ubicación cuando buscas en el mercado, usas el radar geo o guardas la ubicación de tu tarjeta; no hay rastreo continuo en segundo plano.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio",
          "voip"
        ],
        "NSLocalNetworkUsageDescription": "Card-Social needs access to your local network to load Card Studio (market radar) from your development machine.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true,
          "NSAllowsArbitraryLoadsInWebContent": true,
          "NSExceptionDomains": {
            "localhost": {
              "NSTemporaryExceptionAllowsInsecureHTTPLoads": true
            }
          }
        }
      }
    },
    "androidNavigationBar": {
      "visible": "sticky-immersive",
      "backgroundColor": "#00000000",
      "barStyle": "light-content",
      "enforceContrast": false
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.cardsocial.app",
      "versionCode": 21
      ,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "cardsocial.me",
              "pathPrefix": "/u"
            },
            {
              "scheme": "https",
              "host": "cardsocial.me",
              "pathPrefix": "/b"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "com.android.vending.BILLING",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.WAKE_LOCK",
        "android.permission.INTERNET",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-av",
      [
        "expo-camera",
        {
          "cameraPermission": "Card-Social usa la cámara para tu foto de perfil, la selfie de verificación y las videollamadas FaceCall Ghost-Link.",
          "microphonePermission": "Card-Social usa el micrófono para llamadas Ghost-Link y FaceCall."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Card-Social accede a tu galería para que puedas elegir la foto de perfil u otros archivos durante el registro.",
          "cameraPermission": "Card-Social usa la cámara para tu foto de perfil, la selfie de verificación y las videollamadas FaceCall Ghost-Link."
        }
      ],
      "expo-video",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Card-Social usa tu ubicación cuando buscas en el mercado o cuando guardas la ubicación de tu tarjeta de negocio; no hay rastreo continuo en segundo plano."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/cs-icon-logo.png",
          "color": "#2F7BFF",
          "defaultChannel": "ghost-link-calls",
          "sounds": [],
          "enableBackgroundRemoteNotifications": true
        }
      ],
      [
        "react-native-permissions/app.plugin.js",
        {
          "iosPermissions": [
            "Camera"
          ]
        }
      ],
      "expo-localization",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-secure-store",
      "expo-navigation-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "63df0a01-75f5-40bf-96be-2fdfde55c77f"
      }
    }
  }
}
