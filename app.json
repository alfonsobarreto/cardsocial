{
  "expo": {
    "name": "card-social",
    "slug": "card-social",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/CS Icon Logo.png",
    "scheme": "cardsocial",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/CS Icon Logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "deepLinks": [
      "cardsocial://",
      "cardsocial://redeem",
      "cardsocial://redeem?code=*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cardsocial.app",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "googlegmail",
          "ms-outlook",
          "ymail"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/CS Icon Logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.cardsocial.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-video",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Card-Social usa tu ubicación solo cuando pulsas Buscar o Cercanos en el mercado; la app deja de usarla tras unos minutos (sin rastreo continuo)."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
