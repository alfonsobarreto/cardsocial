import React, { useState, useEffect } from 'react';
import {
  StyleSheet,
  View,
  Text,
  TextInput,
  TouchableOpacity,
  ScrollView,
  KeyboardAvoidingView,
  TouchableWithoutFeedback,
  Keyboard,
  Platform,
  Modal,
  FlatList,
  Dimensions,
  Image,
  ActivityIndicator,
} from 'react-native';
import * as DocumentPicker from 'expo-document-picker';
import { MaterialCommunityIcons } from '@expo/vector-icons';

const SCREEN_HEIGHT = Dimensions.get('window').height;
const SCREEN_WIDTH = Dimensions.get('window').width;

// ═══════════════════════════════════════════════════════════════
// TIPOS Y CONSTANTES
// ═══════════════════════════════════════════════════════════════

type DataType = 'Enlaces' | 'Teléfono' | 'Email' | 'Texto Plain' | 'Documento';

const ICON_GALLERY = [
  { id: 'whatsapp', label: 'WhatsApp', icon: 'whatsapp' },
  { id: 'facebook', label: 'Facebook', icon: 'facebook' },
  { id: 'instagram', label: 'Instagram', icon: 'instagram' },
  { id: 'linkedin', label: 'LinkedIn', icon: 'linkedin' },
  { id: 'web', label: 'Web', icon: 'earth' },
  { id: 'location', label: 'Ubicación', icon: 'map-marker' },
  { id: 'call', label: 'Llamada', icon: 'phone' },
  { id: 'email', label: 'Email', icon: 'email' },
  { id: 'document', label: 'Documento', icon: 'file-document' },
  { id: 'video', label: 'Video', icon: 'video' },
];

const COUNTRY_CODES = [
  { code: '+1', country: 'USA/Canadá' },
  { code: '+52', country: 'México' },
  { code: '+34', country: 'España' },
  { code: '+44', country: 'Reino Unido' },
  { code: '+33', country: 'Francia' },
  { code: '+49', country: 'Alemania' },
  { code: '+55', country: 'Brasil' },
  { code: '+39', country: 'Italia' },
  { code: '+61', country: 'Australia' },
  { code: '+81', country: 'Japón' },
];

// ═══════════════════════════════════════════════════════════════
// COMPONENTE PRINCIPAL
// ═══════════════════════════════════════════════════════════════

const NewInfoForm = () => {
  // STATE
  const [dataType, setDataType] = useState<DataType>('Enlaces');
  const [dataName, setDataName] = useState('');
  const [dataValue, setDataValue] = useState('');
  const [selectedIcon, setSelectedIcon] = useState<string | null>(null);
  const [faviconUrl, setFaviconUrl] = useState<string | null>(null);
  const [faviconLoading, setFaviconLoading] = useState(false);
  const [countryCode, setCountryCode] = useState('+1');

  // MODALS
  const [typeDropdownVisible, setTypeDropdownVisible] = useState(false);
  const [countryDropdownVisible, setCountryDropdownVisible] = useState(false);
  const [iconGalleryVisible, setIconGalleryVisible] = useState(false);

  // ═══════════════════════════════════════════════════════════════
  // VALIDACIÓN Y LÓGICA
  // ═══════════════════════════════════════════════════════════════

  // Validar URL
  const isValidUrl = (url: string): boolean => {
    try {
      new URL(url.startsWith('http') ? url : `https://${url}`);
      return true;
    } catch {
      return false;
    }
  };

  // Extraer dominio de URL
  const extractDomain = (url: string): string => {
    try {
      const urlObj = new URL(url.startsWith('http') ? url : `https://${url}`);
      return urlObj.hostname;
    } catch {
      return url;
    }
  };

  // AUTO-FETCH FAVICON cuando cambia a Enlaces
  useEffect(() => {
    if (dataType === 'Enlaces' && dataValue) {
      if (isValidUrl(dataValue)) {
        setFaviconLoading(true);
        const domain = extractDomain(dataValue);
        const faviconEndpoint = `https://www.google.com/s2/favicons?sz=64&domain=${domain}`;
        setFaviconUrl(faviconEndpoint);
        setFaviconLoading(false);
      } else {
        setFaviconUrl(null);
      }
    } else {
      setFaviconUrl(null);
    }
  }, [dataValue, dataType]);

  // Validar Email
  const validateEmail = (email: string): boolean => {
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    return emailRegex.test(email);
  };

  const isEmailValid =
    dataType === 'Email'
      ? dataValue.length === 0
        ? true
        : validateEmail(dataValue)
      : true;

  // Contar palabras
  const wordCount = dataValue.split(/\s+/).filter((word: string) => word.length > 0).length;
  const isWordCountValid = dataType === 'Texto Plain' ? wordCount <= 200 : true;

  // Document Picker
  const handlePickDocument = async () => {
    const result = await DocumentPicker.getDocumentAsync({
      type: [
        'application/pdf',
        'image/*',
        'application/msword',
        'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
      ],
    });
    if (!result.canceled && result.assets && result.assets.length > 0) {
      const { name } = result.assets[0];
      setDataValue(name);
    }
  };

  // ═══════════════════════════════════════════════════════════════
  // RENDER: CAMPO DATA DINÁMICO
  // ═══════════════════════════════════════════════════════════════

  const renderDataField = () => {
    switch (dataType) {
      case 'Documento':
        return (
          <TouchableOpacity style={styles.documentButton} onPress={handlePickDocument}>
            <MaterialCommunityIcons name="folder-open" color="#0A2540" size={28} />
            <Text style={styles.documentButtonText}>CARGAR DESDE CELULAR</Text>
          </TouchableOpacity>
        );

      case 'Teléfono':
        return (
          <View style={styles.phoneContainer}>
            <TouchableOpacity
              style={styles.countryCodeButton}
              onPress={() => setCountryDropdownVisible(true)}
            >
              <Text style={styles.countryCodeText}>{countryCode}</Text>
              <MaterialCommunityIcons name="chevron-down" color="#C5A065" size={16} />
            </TouchableOpacity>
            <TextInput
              style={styles.phoneInput}
              placeholder="Número de teléfono"
              placeholderTextColor="#666"
              value={dataValue}
              onChangeText={setDataValue}
              keyboardType="phone-pad"
            />
          </View>
        );

      case 'Email':
        return (
          <View>
            <TextInput
              style={[
                styles.input,
                !isEmailValid && dataValue.length > 0 && styles.inputError,
              ]}
              placeholder="correo@ejemplo.com"
              placeholderTextColor="#666"
              value={dataValue}
              onChangeText={setDataValue}
              keyboardType="email-address"
            />
            {!isEmailValid && dataValue.length > 0 && (
              <Text style={styles.errorText}>Email inválido</Text>
            )}
          </View>
        );

      case 'Texto Plain':
        return (
          <View>
            <TextInput
              style={[styles.input, !isWordCountValid && styles.inputError]}
              placeholder="Escribe tu texto aquí (máx. 200 palabras)"
              placeholderTextColor="#666"
              value={dataValue}
              onChangeText={setDataValue}
              multiline
              numberOfLines={4}
              maxLength={1200}
            />
            <Text style={styles.wordCount}>{wordCount}/200 palabras</Text>
            {!isWordCountValid && (
              <Text style={styles.errorText}>Límite de 200 palabras excedido</Text>
            )}
          </View>
        );

      case 'Enlaces':
      default:
        return (
          <View>
            <TextInput
              style={styles.input}
              placeholder="https://ejemplo.com"
              placeholderTextColor="#666"
              value={dataValue}
              onChangeText={setDataValue}
              keyboardType="url"
            />
            {faviconLoading && (
              <View style={styles.faviconLoadingContainer}>
                <ActivityIndicator size="small" color="#C5A065" />
                <Text style={styles.faviconLoadingText}>Buscando icono...</Text>
              </View>
            )}
          </View>
        );
    }
  };

  // ═══════════════════════════════════════════════════════════════
  // RENDER: MODALS
  // ═══════════════════════════════════════════════════════════════

  const renderTypeModal = () => (
    <Modal
      visible={typeDropdownVisible}
      transparent
      animationType="slide"
      onRequestClose={() => setTypeDropdownVisible(false)}
    >
      <TouchableWithoutFeedback onPress={() => setTypeDropdownVisible(false)}>
        <View style={styles.modalOverlay}>
          <View style={styles.dropdownMenuModal}>
            {/* HEADER */}
            <View style={styles.modalHeader}>
              <Text style={styles.modalHeaderText}>🎯 SELECCIONA UN TIPO</Text>
            </View>

            {/* ITEMS */}
            <FlatList
              data={['Enlaces', 'Teléfono', 'Email', 'Texto Plain', 'Documento'] as DataType[]}
              keyExtractor={(item) => item}
              scrollEnabled={true}
              renderItem={({ item }) => (
                <TouchableOpacity
                  style={[
                    styles.dropdownItemContainer,
                    dataType === item && styles.dropdownItemContainerActive,
                  ]}
                  onPress={() => {
                    setDataType(item);
                    setDataValue('');
                    setSelectedIcon(null);
                    setFaviconUrl(null);
                    setTypeDropdownVisible(false);
                  }}
                >
                  <View style={styles.dropdownItemContent}>
                    <Text style={[
                      styles.dropdownItemText,
                      dataType === item && styles.dropdownItemTextActive,
                    ]}>
                      {item}
                    </Text>
                    {dataType === item && (
                      <MaterialCommunityIcons name="check-circle" color="#C5A065" size={20} />
                    )}
                  </View>
                </TouchableOpacity>
              )}
            />

            <View style={{ height: 20 }} />
          </View>
        </View>
      </TouchableWithoutFeedback>
    </Modal>
  );

  const renderCountryModal = () => (
    <Modal
      visible={countryDropdownVisible}
      transparent
      animationType="fade"
      onRequestClose={() => setCountryDropdownVisible(false)}
    >
      <TouchableWithoutFeedback onPress={() => setCountryDropdownVisible(false)}>
        <View style={styles.modalOverlay}>
          <View style={styles.dropdownMenu}>
            <FlatList
              data={COUNTRY_CODES}
              keyExtractor={(item) => item.code}
              scrollEnabled={true}
              renderItem={({ item }) => (
                <TouchableOpacity
                  style={styles.dropdownItem}
                  onPress={() => {
                    setCountryCode(item.code);
                    setCountryDropdownVisible(false);
                  }}
                >
                  <Text style={styles.dropdownItemText}>
                    {item.code} - {item.country}
                  </Text>
                </TouchableOpacity>
              )}
            />
          </View>
        </View>
      </TouchableWithoutFeedback>
    </Modal>
  );

  const renderIconGalleryModal = () => (
    <Modal
      visible={iconGalleryVisible}
      transparent
      animationType="slide"
      onRequestClose={() => setIconGalleryVisible(false)}
    >
      <TouchableWithoutFeedback onPress={() => setIconGalleryVisible(false)}>
        <View style={styles.modalOverlay}>
          <View style={styles.iconGalleryContainer}>
            <View style={styles.galleryHeader}>
              <Text style={styles.galleryTitle}>SELECCIONA UN ICONO</Text>
              <TouchableOpacity onPress={() => setIconGalleryVisible(false)}>
                <MaterialCommunityIcons name="close" color="#C5A065" size={24} />
              </TouchableOpacity>
            </View>

            <FlatList
              data={ICON_GALLERY}
              keyExtractor={(item) => item.id}
              numColumns={5}
              contentContainerStyle={styles.iconGridContainer}
              scrollEnabled={true}
              renderItem={({ item }) => (
                <TouchableOpacity
                  style={[
                    styles.iconGalleryButton,
                    selectedIcon === item.id && styles.iconGalleryButtonSelected,
                  ]}
                  onPress={() => {
                    setSelectedIcon(item.id);
                    setIconGalleryVisible(false);
                  }}
                >
                  <MaterialCommunityIcons
                    name={item.icon as any}
                    color={selectedIcon === item.id ? '#0A2540' : '#C5A065'}
                    size={40}
                  />
                  <Text
                    style={[
                      styles.iconLabel,
                      selectedIcon === item.id && styles.iconLabelSelected,
                    ]}
                  >
                    {item.label}
                  </Text>
                </TouchableOpacity>
              )}
            />
          </View>
        </View>
      </TouchableWithoutFeedback>
    </Modal>
  );

  // ═══════════════════════════════════════════════════════════════
  // RENDER PRINCIPAL
  // ═══════════════════════════════════════════════════════════════

  return (
    <TouchableWithoutFeedback onPress={() => Keyboard.dismiss()}>
      <View style={{ flex: 1, backgroundColor: '#0A2540' }}>
        <KeyboardAvoidingView
          style={{ flex: 1 }}
          behavior={Platform.OS === 'ios' ? 'padding' : 'height'}
        >
          <ScrollView
            style={styles.container}
            contentContainerStyle={styles.contentContainer}
            scrollEnabled={true}
            keyboardShouldPersistTaps="handled"
          >
            {/* HEADER */}
            <View style={styles.header}>
              <Text style={styles.title}>NUEVA INFORMACIÓN</Text>
              <Text style={styles.subtitle}>Gestiona tus datos de contacto con seguridad</Text>
            </View>

            {/* 🎯 SECCIÓN 1: TIPO DE DATA - FILTRO PRINCIPAL */}
            <View style={styles.typeDataSection}>
              <Text style={styles.typeDataLabel}>📌 TIPO DE DATA (Selecciona uno)</Text>
              
              <TouchableOpacity
                activeOpacity={0.7}
                style={styles.dropdownButton}
                onPress={() => {
                  setTypeDropdownVisible(true);
                }}
              >
                <Text style={styles.dropdownButtonText}>▼ {dataType}</Text>
                <MaterialCommunityIcons name="chevron-down" color="#C5A065" size={20} />
              </TouchableOpacity>

              <Text style={styles.helpText}>
                💡 Elige el tipo de dato que quieres guardar
              </Text>
            </View>

            {/* SECCIÓN 2: NOMBRE DE DATA */}
            <View style={styles.formSection}>
              <Text style={styles.label}>NOMBRE DE DATA</Text>
              <TextInput
                style={styles.input}
                placeholder="Ej: Mi Celular Personal"
                placeholderTextColor="#666"
                value={dataName}
                onChangeText={setDataName}
              />
            </View>

            {/* SECCIÓN 3: DATA (Dinámica según tipo) */}
            <View style={styles.formSection}>
              <Text style={styles.label}>DATA</Text>
              {renderDataField()}
            </View>

            {/* SECCIÓN 4: ICONO CON GALERÍA */}
            <View style={styles.formSection}>
              <View style={styles.iconLabelRow}>
                <Text style={styles.label}>ICONO</Text>
                <TouchableOpacity
                  style={styles.iconPlusButton}
                  onPress={() => setIconGalleryVisible(true)}
                >
                  <MaterialCommunityIcons name="plus" color="#0A2540" size={22} />
                </TouchableOpacity>
              </View>

              {/* PREVIEW ICONO */}
              {faviconUrl && dataType === 'Enlaces' ? (
                <View style={styles.faviconPreview}>
                  <Image
                    source={{ uri: faviconUrl }}
                    style={styles.faviconImage}
                    onError={() => setFaviconUrl(null)}
                  />
                  <Text style={styles.faviconLabel}>Favicon detectado</Text>
                </View>
              ) : selectedIcon ? (
                <View style={styles.selectedIconPreview}>
                  <MaterialCommunityIcons
                    name={(ICON_GALLERY.find((i) => i.id === selectedIcon)?.icon) as any}
                    color="#C5A065"
                    size={48}
                  />
                  <Text style={styles.selectedIconName}>
                    {ICON_GALLERY.find((i) => i.id === selectedIcon)?.label}
                  </Text>
                </View>
              ) : (
                <View style={styles.noIconPlaceholder}>
                  <MaterialCommunityIcons name="image-plus" color="#999" size={40} />
                  <Text style={styles.noIconText}>Sin icono seleccionado</Text>
                </View>
              )}
            </View>

            {/* BOTÓN CREAR */}
            <TouchableOpacity
              style={[
                styles.createButton,
                (!dataName || !dataValue || !isEmailValid || !isWordCountValid) &&
                  styles.createButtonDisabled,
              ]}
              disabled={!dataName || !dataValue || !isEmailValid || !isWordCountValid}
            >
              <MaterialCommunityIcons name="check-circle" color="#0A2540" size={24} />
              <Text style={styles.createButtonText}>CREAR INFORMACIÓN</Text>
            </TouchableOpacity>
          </ScrollView>
        </KeyboardAvoidingView>

        {/* MODALS: FUERA DEL SCROLL */}
        {renderTypeModal()}
        {renderCountryModal()}
        {renderIconGalleryModal()}
      </View>
    </TouchableWithoutFeedback>
  );
};

// ═══════════════════════════════════════════════════════════════
// ESTILOS PREMIUM
// ═══════════════════════════════════════════════════════════════

const styles = StyleSheet.create({
  // MAIN CONTAINER
  container: {
    flex: 1,
    backgroundColor: '#0A2540',
  },
  contentContainer: {
    padding: 20,
    paddingBottom: 40,
  },

  // HEADER
  header: {
    marginBottom: 32,
  },
  title: {
    fontSize: 32,
    fontWeight: '700',
    color: '#FFFFFF',
    marginBottom: 8,
    letterSpacing: 0.5,
  },
  subtitle: {
    fontSize: 14,
    color: '#999',
    fontWeight: '300',
    letterSpacing: 0.2,
  },

  // FORM SECTION
  formSection: {
    marginBottom: 28,
  },
  label: {
    fontSize: 11,
    fontWeight: '700',
    color: '#C5A065',
    marginBottom: 12,
    letterSpacing: 0.8,
    textTransform: 'uppercase',
  },

  // NUEVO: Estilos para TIPO DE DATA
  typeDataSection: {
    backgroundColor: '#0D3A56',
    padding: 16,
    borderRadius: 12,
    borderLeftWidth: 4,
    borderLeftColor: '#C5A065',
    marginBottom: 28,
    borderTopWidth: 1,
    borderTopColor: '#1A5A7A',
  },

  typeDataLabel: {
    fontSize: 13,
    fontWeight: '700',
    color: '#FFFFFF',
    marginBottom: 16,
    letterSpacing: 1,
  },

  helpText: {
    fontSize: 11,
    color: '#999',
    marginTop: 12,
    fontStyle: 'italic',
    fontWeight: '400',
  },

  // INPUT BASE
  input: {
    backgroundColor: '#1A3A52',
    borderColor: '#C5A065',
    borderWidth: 1.2,
    borderRadius: 10,
    paddingHorizontal: 16,
    paddingVertical: 14,
    color: '#FFFFFF',
    fontSize: 15,
    fontWeight: '500',
    minHeight: 50,
  },
  inputError: {
    borderColor: '#FF6B6B',
  },

  // DROPDOWN BUTTON
  dropdownButton: {
    flexDirection: 'row',
    justifyContent: 'space-between',
    alignItems: 'center',
    backgroundColor: '#1A3A52',
    borderColor: '#C5A065',
    borderWidth: 1.2,
    borderRadius: 10,
    paddingHorizontal: 16,
    paddingVertical: 14,
    minHeight: 50,
  },
  dropdownButtonText: {
    color: '#FFFFFF',
    fontSize: 18,
    fontWeight: '700',
    letterSpacing: 0.5,
  },

  // MODAL OVERLAY
  modalOverlay: {
    flex: 1,
    backgroundColor: 'rgba(0, 0, 0, 0.7)',
    justifyContent: 'flex-end',
  },
  
  dropdownMenuModal: {
    backgroundColor: '#1A3A52',
    borderTopLeftRadius: 24,
    borderTopRightRadius: 24,
    maxHeight: SCREEN_HEIGHT * 0.65,
    borderTopWidth: 2,
    borderTopColor: '#C5A065',
  },

  modalHeader: {
    paddingHorizontal: 20,
    paddingVertical: 16,
    borderBottomWidth: 1,
    borderBottomColor: '#0A2540',
    backgroundColor: '#0D3A56',
    borderTopLeftRadius: 24,
    borderTopRightRadius: 24,
  },

  modalHeaderText: {
    fontSize: 18,
    fontWeight: '700',
    color: '#C5A065',
    textAlign: 'center',
    letterSpacing: 1,
  },

  dropdownItemContainer: {
    paddingHorizontal: 20,
    paddingVertical: 18,
    marginVertical: 2,
    marginHorizontal: 8,
    borderRadius: 8,
    backgroundColor: '#1A3A52',
  },

  dropdownItemContainerActive: {
    backgroundColor: '#0A2540',
    borderLeftWidth: 4,
    borderLeftColor: '#C5A065',
  },

  dropdownItemContent: {
    flexDirection: 'row',
    justifyContent: 'space-between',
    alignItems: 'center',
  },

  dropdownItemText: {
    fontSize: 16,
    fontWeight: '700',
    color: '#FFFFFF',
  },

  dropdownItemTextActive: {
    color: '#C5A065',
  },

  // LEGACY DROPDOWN MENU (para otros modals)
  dropdownMenu: {
    backgroundColor: '#1A3A52',
    borderTopLeftRadius: 20,
    borderTopRightRadius: 20,
    maxHeight: SCREEN_HEIGHT * 0.6,
    borderTopWidth: 2,
    borderTopColor: '#C5A065',
    paddingTop: 8,
  },

  dropdownItem: {
    paddingHorizontal: 20,
    paddingVertical: 16,
    borderBottomColor: '#0A2540',
    borderBottomWidth: 0.5,
  },

  // TELÉFONO
  phoneContainer: {
    flexDirection: 'row',
    gap: 10,
  },
  countryCodeButton: {
    flexDirection: 'row',
    alignItems: 'center',
    justifyContent: 'center',
    backgroundColor: '#1A3A52',
    borderColor: '#C5A065',
    borderWidth: 1.2,
    borderRadius: 10,
    paddingHorizontal: 12,
    gap: 4,
    minWidth: 80,
    minHeight: 50,
  },
  countryCodeText: {
    color: '#FFFFFF',
    fontSize: 15,
    fontWeight: '600',
  },
  phoneInput: {
    flex: 1,
    backgroundColor: '#1A3A52',
    borderColor: '#C5A065',
    borderWidth: 1.2,
    borderRadius: 10,
    paddingHorizontal: 16,
    paddingVertical: 14,
    color: '#FFFFFF',
    fontSize: 15,
    fontWeight: '500',
  },

  // VALIDATION MESSAGES
  wordCount: {
    fontSize: 12,
    color: '#999',
    marginTop: 8,
    fontWeight: '400',
  },
  errorText: {
    fontSize: 12,
    color: '#FF6B6B',
    marginTop: 8,
    fontWeight: '600',
  },

  // DOCUMENT BUTTON
  documentButton: {
    flexDirection: 'row',
    alignItems: 'center',
    justifyContent: 'center',
    backgroundColor: '#C5A065',
    paddingHorizontal: 20,
    paddingVertical: 20,
    borderRadius: 12,
    gap: 12,
    minHeight: 60,
    shadowColor: '#C5A065',
    shadowOffset: { width: 0, height: 4 },
    shadowOpacity: 0.35,
    shadowRadius: 8,
    elevation: 6,
  },
  documentButtonText: {
    color: '#0A2540',
    fontSize: 15,
    fontWeight: '700',
    letterSpacing: 0.5,
  },

  // FAVICON LOADING
  faviconLoadingContainer: {
    flexDirection: 'row',
    alignItems: 'center',
    gap: 8,
    marginTop: 12,
    paddingHorizontal: 12,
    paddingVertical: 8,
  },
  faviconLoadingText: {
    color: '#C5A065',
    fontSize: 12,
    fontWeight: '600',
  },
  faviconPreview: {
    flexDirection: 'row',
    alignItems: 'center',
    backgroundColor: '#1A3A52',
    borderColor: '#C5A065',
    borderWidth: 1.2,
    borderRadius: 10,
    paddingHorizontal: 16,
    paddingVertical: 12,
    gap: 12,
    minHeight: 60,
  },
  faviconImage: {
    width: 48,
    height: 48,
    borderRadius: 8,
    backgroundColor: '#0A2540',
  },
  faviconLabel: {
    color: '#C5A065',
    fontSize: 14,
    fontWeight: '600',
  },

  // ICON LABEL ROW
  iconLabelRow: {
    flexDirection: 'row',
    justifyContent: 'space-between',
    alignItems: 'center',
    marginBottom: 12,
  },
  iconPlusButton: {
    width: 40,
    height: 40,
    borderRadius: 12,
    backgroundColor: '#C5A065',
    justifyContent: 'center',
    alignItems: 'center',
    shadowColor: '#C5A065',
    shadowOffset: { width: 0, height: 3 },
    shadowOpacity: 0.4,
    shadowRadius: 6,
    elevation: 5,
  },

  // SELECTED ICON PREVIEW
  selectedIconPreview: {
    backgroundColor: '#1A3A52',
    borderColor: '#C5A065',
    borderWidth: 1.2,
    borderRadius: 10,
    paddingVertical: 20,
