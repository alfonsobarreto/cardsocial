PORT=4000
MONGO_URI=
# Si `mongodb+srv://` falla con querySrv ECONNREFUSED en Windows, el backend usa DNS públicos (8.8.8.8, 1.1.1.1).
# Para usar solo el DNS del sistema: MONGO_DNS_SERVERS=off
# MONGO_DNS_SERVERS=8.8.8.8,1.1.1.1
MONGO_DB_NAME=cardsocial

# Azure Content Safety (moderacion de imagenes/texto)
# Canónicos: AZURE_CONTENT_SAFETY_*. Alias soportados: CONTENT_SAFETY_ENDPOINT, CONTENT_SAFETY_KEY.
# ENDPOINT = base del recurso (ej. https://TU_RECURSO.cognitiveservices.azure.com) sin barra final.
AZURE_CONTENT_SAFETY_ENDPOINT=
AZURE_CONTENT_SAFETY_KEY=
AZURE_CONTENT_SAFETY_API_VERSION=2024-09-01

# Correo transaccional (Resend) — igual que frontend-web donde aplique.
RESEND_API_KEY=
# Notificaciones / broadcast (fallback si no se pasa `from` en sendEmail). Debe estar verificado en Resend.
EMAIL_FROM=
# Opcional: remitentes por flujo (si no se definen, se usan los valores por defecto con dominio cardsocial.me).
# EMAIL_SENDER_VERIFICATION=Card-Social Verification <verification@cardsocial.me>
# EMAIL_SENDER_SUPPORT=Card-Social Support <support@cardsocial.me>
# EMAIL_SENDER_NOTIFICATIONS=Card-Social <notifications@cardsocial.me>

# Remitente Resend para verificación / OTP / reset / cambio de correo (prioridad absoluta; no usa EMAIL_VERIFICATION_FROM).
EMAIL_SENDER_VERIFICATION=Card-Social Verification <verification@cardsocial.me>
# Obsoleto para Resend: no sustituye a EMAIL_SENDER_VERIFICATION. Mantén solo si otras herramientas lo documentan.
# EMAIL_VERIFICATION_FROM=
# URL HTTPS tras acciones de correo (Auth authorized domains). Misma idea que EXPO_PUBLIC_EMAIL_VERIFICATION_CONTINUE_URL.
EMAIL_VERIFICATION_CONTINUE_URL=https://cardsocial.me

# API Gateway / JWT
API_GATEWAY_KEY=
MODERATION_JWT_SECRET=
MODERATION_JWT_ISSUER=cardsocial-gateway
MODERATION_JWT_AUDIENCE=cardsocial-moderation
EMAIL_OTP_SECRET=

# Comma-separated Firebase Auth UIDs allowed for POST /api/auth/token scopes admin.system + admin.broadcast
ADMIN_SYSTEM_STATS_UIDS=

# Opcional: UIDs extra solo para broadcast (si vacío, basta ADMIN_SYSTEM_STATS_UIDS)
ADMIN_BROADCAST_UIDS=

# Obligatorio para /api/account/deletion-scheduled-notify (verificar ID token + Firestore): en Azure App Service
# → Configuration → Application settings → Nueva: FIREBASE_SERVICE_ACCOUNT_JSON = contenido JSON del service account (una línea o Key Vault).
# Obtener: Firebase Console → Project settings (engranaje) → Service accounts → Generate new private key → JSON descargado.
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Admin panel (legacy HTML)
ADMIN_USER=
ADMIN_PASS_HASH=
ADMIN_JWT_SECRET=
ADMIN_JWT_ISSUER=cardsocial-admin
ADMIN_JWT_AUDIENCE=cardsocial-admin-api

# Social OAuth (opcional, MVP desactivado)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Email fallback SMTP (opcional, usar Azure ACS preferido)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# RevenueCat — servidor (webhook + API v2 métricas). Usa la Secret API key del proyecto
# (Project settings → API keys), NO la clave pública del wizard de la app (test_/appl_/goog_).
REVENUECAT_API_KEY=

# Mercado Pago Checkout Pro (Perú — soles PEN y dólares USD)
# Credenciales: https://www.mercadopago.com.pe/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
# 1/true = usar sandbox_init_point (pruebas)
MERCADOPAGO_SANDBOX=0
# URL pública del webhook (prod: https://api.cardsocial.me/api/payments/mercadopago/webhook)
# MERCADOPAGO_NOTIFICATION_URL=
# Base HTTPS del API para armar webhook si no usas MERCADOPAGO_NOTIFICATION_URL
# MERCADOPAGO_WEBHOOK_BASE_URL=https://api.cardsocial.me
# Tasa USD→PEN si el CMS publica precios en USD (opcional; default 3.75)
MERCADOPAGO_USD_TO_PEN_RATE=3.75
# ID del proyecto (URL del dashboard o API: proj…)
REVENUECAT_PROJECT_ID=

# DigitalOcean Spaces — obligatorias para S3 (`config.js` lee el prefijo DO_)
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_ENDPOINT=sfo3.digitaloceanspaces.com
DO_SPACES_REGION=sfo3
DO_SPACES_BUCKET=cardsocial-assets

# QR universal (24h) — host donde existe `/u/[token]` (Next en 3001, prod, o LAN sin barra final).
# Para la app Expo usas también EXPO_PUBLIC_BUSINESS_WEB_BASE en la `.env` de la RAÍZ del monorepo — el backend
# ahora carga esa `.env`, y SI PUBLIC_UNIVERSAL_CARD_BASE_URL apunta a localhost/127 se ignora para el QR
# y se usa tu EXPO_PUBLIC_BUSINESS_WEB_BASE (ej. http://192.168.x.x:3001) para enlaces escaneables.
PUBLIC_UNIVERSAL_CARD_BASE_URL=https://cardsocial.me
# Opcional mismo propósito desde raíz del repo (prioridad segunda si universal es loopback):
# EXPO_PUBLIC_BUSINESS_WEB_BASE=http://192.168.x.x:3001
# Host público del proxy de vault (mismo API + Mongo que POST /api/upload). Sin barra final.
# La ruta del archivo es /api/qr/vault-proxy/file/:uuid (prefijo /api/qr suele pasar WAF; /api/vault a veces no).
# PUBLIC_VAULT_FILE_BASE_URL=https://api.cardsocial.me
# Si el proxy reenvía todo /u/* al API, pon 1 para redirigir a /?universalToken=... tras validar
UNIVERSAL_VALID_REDIRECT_USE_ROOT=0
# Next.js embebido: URL del mismo Express (loopback) para SSR sin pasar por el dominio público
# INTERNAL_API_URL=http://127.0.0.1:4000
