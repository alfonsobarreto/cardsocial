PORT=4000
MONGO_URI=
MONGO_DB_NAME=cardsocial

# Azure Content Safety (moderacion de imagenes/texto)
AZURE_CONTENT_SAFETY_ENDPOINT=
AZURE_CONTENT_SAFETY_KEY=
AZURE_CONTENT_SAFETY_API_VERSION=2024-09-01

# Azure Communication Services (email transaccional)
AZURE_EMAIL_CONNECTION_STRING=

# API Gateway / JWT
API_GATEWAY_KEY=
MODERATION_JWT_SECRET=
MODERATION_JWT_ISSUER=cardsocial-gateway
MODERATION_JWT_AUDIENCE=cardsocial-moderation
EMAIL_OTP_SECRET=
EMAIL_FROM=

# Admin panel
ADMIN_USER=
ADMIN_PASS_HASH=
ADMIN_JWT_SECRET=
ADMIN_JWT_ISSUER=cardsocial-admin
ADMIN_JWT_AUDIENCE=cardsocial-admin-api

# Social OAuth (opcional, MVP desactivado)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Email fallback SMTP (opcional, usar Azure ACS preferido)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# RevenueCat (suscripciones)
REVENUECAT_API_KEY=

# DigitalOcean Spaces (archivos pesados: wallpapers, QR, iconos, fotos de perfil)
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_ENDPOINT=sfo3.digitaloceanspaces.com
DO_SPACES_BUCKET=cardsocial-assets
DO_SPACES_REGION=sfo3
