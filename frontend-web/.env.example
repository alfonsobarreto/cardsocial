# RevenueCat Web Billing — clave pública del proyecto (sandbox suele empezar por rcb_sb_).
# NO uses claves secretas de Stripe (sk_/strp_...) aquí; conecta Stripe a RevenueCat en el dashboard.
# @see https://www.revenuecat.com/docs/web/web-billing/web-sdk
NEXT_PUBLIC_REVENUECAT_WEB_API_KEY=

# Mapbox GL (Card Studio Hyper-Local Market Intent heatmap). Do not commit real tokens.
# Next.js exposes NEXT_PUBLIC_* to the browser — treat as publishable restriction token only.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Market Radar Fase 4: buckets sintéticos in-memory (demo/searchDemand). Muestra toggle admin en el mapa.
NEXT_PUBLIC_GLOBAL_DEMO_MODE=

# Heatmap: no mock/API fetch until user applies intent keyword (length ≥ 2). See lib/marketRadarBootstrap.ts
NEXT_PUBLIC_MARKET_RADAR_REQUIRE_INTENT=

# Solo desarrollo (`next dev`): /studio/market-radar sin login Firebase. No tiene efecto en `next build` + `next start`.
# Alternativa sin tocar .env: abre en el navegador del móvil
#   http://<TU_LAN>:3001/studio/market-radar?dev_open=1&lang=es
NEXT_PUBLIC_STUDIO_DEV_OPEN_RADAR=

# Embed handshake (native WebView → `/embed/market-radar`): HMAC secret for short-lived `et` (min 16 chars).
# Keep server-only — do not use EXPO_PUBLIC_* or NEXT_PUBLIC_*.
STUDIO_EMBED_SECRET=

# Optional: extra Firebase Admin / mint radar logs on the Next server (set to 1). Still does not print private keys.
DEBUG_FIREBASE_ADMIN=

# Firebase Admin: verify ID tokens and mint custom tokens. JSON string of the service account key.
# If cert fails ("Unparsed DER bytes…"), the private_key in the JSON is corrupt — download a new key in Firebase Console (IAM) and replace.
# Alternatively set FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-adminsdk.local.json (gitignored) with the full JSON file.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Waitlist / lead gen email pipeline.
# Resend sender must be verified in your Resend account for production.
RESEND_API_KEY=

# Firebase Auth: HTTPS continue URL for verification / verify-before-update-email links.
# Must be listed under Firebase Console → Authentication → Settings → Authorized domains.
# Default in `@card-social/services/emailVerificationActionCode.ts` is https://cardsocial.me/
# Verificación: texto sugerido del correo (asunto/cuerpo EN+ES) en `services/firebaseAuthVerificationEmailCopy.ts` → pegar en Auth → Templates.
NEXT_PUBLIC_EMAIL_VERIFICATION_CONTINUE_URL=https://cardsocial.me/
RESEND_FROM_EMAIL="Card-Social <waitlist@cardsocial.me>"
WAITLIST_NOTIFY_TO=pochobs@gmail.com

# Optional: Make/Integromat webhook that writes each lead into Google Sheets/Airtable/etc.
WAITLIST_WEBHOOK_URL=

# Investor autoresponse link used when interest = investor.
EXECUTIVE_SUMMARY_URL=https://cardsocial.me/executive-summary

# Executive summary / investor page: PDF or URL for "Download pitch deck" (optional). If unset, CTA uses mailto.
# NEXT_PUBLIC_INVESTOR_PITCH_DECK_URL=https://cardsocial.me/legal/card-social-pitch-deck.pdf

# Optional Calendly or booking URL for "Schedule demo / meeting". If unset, demo CTA falls back to /#waitlist.
# NEXT_PUBLIC_INVESTOR_CALENDAR_URL=
