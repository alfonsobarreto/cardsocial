# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files
#
# Nota: ignorar .env / logs NO borra archivos en tu disco; solo evita que Git los incluya en commits.

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# logs
logs/
*.log
backend/logs/
.npm/

# macOS
.DS_Store
*.pem

# local env files — NEVER commit real credentials
.env
.env.local
.env*.local
frontend-admin/.env
backend/.env
backend/.env.local
backend/.env.*.local
# Also block any accidental secret files
*.secret
secrets/

# deployment temp artifacts
backend-deploy*.zip
backend-deploy-staging/
kudu-command.json
token-request.json
moderate-request.json

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
