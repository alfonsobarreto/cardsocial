# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files
#
# Nota: ignorar .env / logs NO borra archivos en tu disco; solo evita que Git los incluya en commits.

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# logs
logs/
*.log
backend/logs/
.npm/

# macOS
.DS_Store
*.pem

# Cursor MCP local (puede contener API keys; la plantilla es mcp.json.example)
.cursor/mcp.json

# local env files — NEVER commit real credentials
.env
.env.local
.env*.local
frontend-admin/.env
backend/.env
backend/.env.local
backend/.env.*.local
# Firebase Admin downloads (use FIREBASE_SERVICE_ACCOUNT_PATH in frontend-web)
frontend-web/firebase-adminsdk*.json
# Also block any accidental secret files
*.secret
secrets/

# deployment temp artifacts
# Volcados locales de logs Azure/Kudu (pesados, pueden contener paths viejos; no versionar)
runtime-logs*/
backend-deploy*.zip
backend-deploy-staging/
kudu-command.json
token-request.json
moderate-request.json

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

#frontend-web
firebase-admin.json

# hosted admin media (uploaded binaries)
backend/public/uploads/*
!backend/public/uploads/.gitkeep