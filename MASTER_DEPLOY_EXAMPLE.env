# =============================================================================
# MASTER_DEPLOY_EXAMPLE.env — plantilla única para despliegue (ej. TestFlight + Azure).
# Copia los valores reales desde vuestros secret managers; NO commiteéis este archivo
# una vez rellenado con datos producción.
#
# Leyenda: [REQ] típico en producción  |  [OPT] opcional según features
# =============================================================================

# =============================================================================
# 1. SECCIÓN BACKEND (Azure App Service → Configuration → Application settings)
# =============================================================================
# Variables del servidor Node/Express (backend/). Deben coincidir con lo que espera
# la app móvil donde toque (p. ej. API_GATEWAY_KEY === EXPO_PUBLIC_MODERATION_GATEWAY_KEY).
# -----------------------------------------------------------------------------

# --- Runtime ---
# [OPT] Puerto local; en Azure IISHttp often uses PORT injected by platform.
PORT=4000

# --- Base de datos (MongoDB Atlas o compatible) ---
# [REQ]
MONGO_URI=mongodb+srv://usuario_demo:PASSWORD_EJEMPLO@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# [OPT] nombre lógico de la BD
MONGO_DB_NAME=cardsocial

# --- Correo transaccional (Resend) ---
# [REQ] API Key del panel Resend (empieza por re_)
RESEND_API_KEY=re_tu_llave_resend_xyz123ABCDEF
# [REQ] Remitente verificado en Resend (dominio propio o sandbox de Resend en dev).
EMAIL_FROM="Card Social <noreply@mail.tudominio.com>"

# --- Firebase Admin (verificación de tokens / rutas como borrado de cuenta) ---
# [REQ] JSON del service account en UNA SOLA LÍNEA (o referencia Key Vault en Azure).
# Obtener: Firebase Console → Project settings → Service accounts → Generate new private key.
# Ejemplo truncado; el real incluye private_key completo y \n escapados:
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"tu-proyecto-firebase","private_key_id":"abc123keyid","private_key":"-----BEGIN PRIVATE KEY-----\nTU_CLAVE_PRIVADA_EN_VARIAS_LINEAS_ESCAPADAS\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxxxx@tu-proyecto-firebase.iam.gserviceaccount.com","client_id":"123456789012345678901","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/..."}

# --- Seguridad API / JWT (Gateway y tokens de moderación) ---
# [REQ] Misma clave que la app móvil envía en X-API-Key (EXPO_PUBLIC_MODERATION_GATEWAY_KEY).
API_GATEWAY_KEY=tu_secreto_gateway_largo_y_aleatorio_min_32_chars
# [REQ] Secreto para firmar JWT internos de moderación.
MODERATION_JWT_SECRET=otro_secreto_largo_para_jwt_moderacion
# [OPT]
MODERATION_JWT_ISSUER=cardsocial-gateway
# [OPT]
MODERATION_JWT_AUDIENCE=cardsocial-moderation
# [REQ] Secreto para OTP / flujos de email (debe ser fuerte y único).
EMAIL_OTP_SECRET=secreto_para_otp_email_no_reutilizar

# --- Azure Content Safety (moderación imagen/texto) ---
# [REQ] según assertRequiredConfig del backend
AZURE_CONTENT_SAFETY_ENDPOINT=https://tu-recurso.cognitiveservices.azure.com
AZURE_CONTENT_SAFETY_KEY=tu_clave_azure_content_safety
# [OPT]
AZURE_CONTENT_SAFETY_API_VERSION=2024-09-01

# --- GitHub OAuth (intercambio servidor; debe cuadrar con EXPO_PUBLIC_GITHUB_CLIENT_ID en el cliente) ---
# [OPT] si usáis login GitHub end-to-end
GITHUB_OAUTH_CLIENT_ID=Ov23lifakeClientIdEjemplo01
GITHUB_OAUTH_CLIENT_SECRET=ghp_fakeSecretServerSideSoloAzure

# --- RevenueCat (servidor — webhooks / API secreta; NO es la SDK pública de la app) ---
# [OPT] si hay validación servidor u operaciones RevenueCat desde backend
REVENUECAT_API_KEY=sk_fake_revenuecat_secret_api_key_servidor
# [OPT]
REVENUECAT_PROJECT_ID=proj_fake12345

# --- Mercado Pago Checkout Pro (Perú — PEN / USD) ---
# [REQ para checkout Perú] Access token desde https://www.mercadopago.com.pe/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=APP_USR-tu_access_token_produccion_o_test
# [OPT] Public key para Checkout Bricks / Wallet (frontend)
MERCADOPAGO_PUBLIC_KEY=APP_USR-tu_public_key
MERCADOPAGO_SANDBOX=1
MERCADOPAGO_USD_TO_PEN_RATE=3.75

# --- DigitalOcean Spaces (S3-compatible; subidas / vault proxy) ---
# [REQ típico prod] todas las DO_SPACES_* siguientes suelen ser necesarias.
DO_SPACES_KEY=DO00FAKEACCESSKEYEXAMPLE123
DO_SPACES_SECRET=fakeSecretAccessKeyCompanion456789ABCDEF
DO_SPACES_ENDPOINT=sfo3.digitaloceanspaces.com
DO_SPACES_REGION=sfo3
DO_SPACES_BUCKET=tu-bucket-cardsocial

# --- URLs públicas que genera o redirige el backend ---
# [REQ típico] host donde vive la tarjeta universal /u/{token} (Next o dominio prod).
PUBLIC_UNIVERSAL_CARD_BASE_URL=https://tu-sitio-publico.com
# [OPT] mismo API si el vault proxy sirve desde el backend (sin barra final).
PUBLIC_VAULT_FILE_BASE_URL=https://tu-url-de-backend-o-api.com
# [OPT] 1 si necesitás redirigir a /?universalToken= tras validar (evitar bucles con proxy).
UNIVERSAL_VALID_REDIRECT_USE_ROOT=0

# --- Admins Firebase UIDs / panel legacy ---
# [OPT] UIDs separados por coma para alcance admin sistema / broadcast
ADMIN_SYSTEM_STATS_UIDS=uidFirebaseAdminEjemplo111,uidFirebaseAdminEjemplo222
ADMIN_BROADCAST_UIDS=
ADMIN_OWNER_UID=

# --- Panel admin legacy (HTML) ---
# [OPT]
ADMIN_USER=admin_ejemplo
ADMIN_PASS_HASH=$2a$10$ejemplo.hash.bcrypt.NO_USAR_EN_PROD
ADMIN_JWT_SECRET=secreto_admin_jwt
ADMIN_JWT_ISSUER=cardsocial-admin
ADMIN_JWT_AUDIENCE=cardsocial-admin-api

# --- Correo SMTP alternativo (opcional si no solo Resend) ---
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usuario_smtp
SMTP_PASS=clave_smtp

# --- CORS panel admin ---
# [OPT] orígenes permitidos separados por coma
ADMIN_CORS_ORIGINS=https://tu-admin.com,http://localhost:3000

# --- Mercado semántico / embeddings (opcional) ---
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=sk-fake-openai-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSIONS=
ATLAS_VECTOR_INDEX_BUSINESS_CARDS=business_cards_vector
ATLAS_VECTOR_INDEX_SMART_CARDS=smart_cards_vector
MARKET_EMBEDDING_FIELD=marketEmbedding

# --- Ghost-Link / Agora (opcional) ---
AGORA_APP_ID=tu_agora_app_id_hex
AGORA_APP_CERTIFICATE=tu_agora_certificate_hex

# --- Otros (presupuestos / admin interno; opcional) ---
STRIPE_SECRET_KEY=sk_test_fake
BUDGET_MONTHLY_NET_REVENUE_USD=
AZURE_MONTHLY_COST_USD=
MONGO_MONTHLY_COST_USD=
AZURE_COST_API_URL=
MONGO_COST_API_URL=
AZURE_COST_API_KEY=
MONGO_COST_API_KEY=
PUBLIC_API_HTML_PREFIX=
PUBLIC_ANALYTICS_VIEWS_PER_WINDOW=12
PUBLIC_ANALYTICS_CLICKS_PER_WINDOW=45
HOUSE_AD_OWNER_UID=

# --- Interno (si desplegáis Next embebido junto al API) ---
# INTERNAL_API_URL=http://127.0.0.1:4000


# =============================================================================
# 2. SECCIÓN APP MÓVIL (EAS Secrets / Expo Dashboard Environment Variables)
# =============================================================================
# Solo nombres EXPO_PUBLIC_* (se inyectan en el bundle JS en build-time).
# Tras crearlas en expo.dev → Environment variables, ejecutad un NUEVO EAS build
# (ej. perfil alpha-testflight) para que queden compiladas en la IPA.
#
# IMPORTANTE:
# - EXPO_PUBLIC_MODERATION_GATEWAY_KEY debe ser IGUAL que API_GATEWAY_KEY del backend.
# - Firebase WEB en el cliente móvil va hoy mayormente hardcodeado en código; igual
#   listamos EXPO_PUBLIC_FIREBASE_* por si migráis a env sin tocar código aún (opcional).
# -----------------------------------------------------------------------------

# --- API backend (al menos BACKEND_BASE o MODERATION_API; pueden repetir la misma URL) ---
EXPO_PUBLIC_BACKEND_BASE_URL=https://tu-url-de-azure.com
EXPO_PUBLIC_MODERATION_API_URL=https://tu-url-de-azure.com
EXPO_PUBLIC_API_URL=https://tu-url-de-azure.com

# --- Seguridad cliente (cabecera X-API-Key) ---
EXPO_PUBLIC_MODERATION_GATEWAY_KEY=tu_secreto_gateway_largo_y_aleatorio_min_32_chars
# [OPT] alias del mismo secreto si usáis nombres distintos en builds antiguos
EXPO_PUBLIC_API_GATEWAY_KEY=tu_secreto_gateway_largo_y_aleatorio_min_32_chars
EXPO_PUBLIC_GATEWAY_KEY=

# --- Card Studio / Market Radar (HTTPS en TestFlight; WebView del dashboard) ---
EXPO_PUBLIC_STUDIO_WEB_URL=https://tu-sitio-publico.com
EXPO_PUBLIC_MARKET_RADAR_WEB_ORIGIN=
EXPO_PUBLIC_LEGACY_RADAR_FALLBACK_ORIGIN=
# Modo pruebas (solo QA): gracia visual en Analítica hasta 31-may-2026 para usuarios no admin. Testing OFF = variable ausente o != 1
# EXPO_PUBLIC_DASHBOARD_TESTING_GRACE_MODE=1

# --- Sitio público negocio / QR / firmas ---
EXPO_PUBLIC_BUSINESS_WEB_BASE=https://tu-sitio-publico.com
EXPO_PUBLIC_BUSINESS_SIGNATURE_PUBLIC_BASE=
EXPO_PUBLIC_SIGNATURE_EMAIL_PUBLIC_BASE=
EXPO_PUBLIC_SIGNATURE_QR_IMAGE_BASE_URL=

# --- Analytics espejo (opcional) ---
EXPO_PUBLIC_ANALYTICS_API_URL=https://tu-url-de-azure.com

# --- Google Sign-In (OAuth client IDs del mismo proyecto Google Cloud) ---
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=123456789-abcdefg.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=123456789-iosclient.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=123456789-androidclient.apps.googleusercontent.com

# --- GitHub (Client ID público; el secret va solo en backend GITHUB_OAUTH_CLIENT_SECRET) ---
EXPO_PUBLIC_GITHUB_CLIENT_ID=Ov23lifakeClientIdEjemplo01

# --- RevenueCat (SDK pública / por plataforma; NO la Secret del servidor) ---
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_TuClavePublicaIOSRevenueCat
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_TuClavePublicaAndroidRevenueCat
EXPO_PUBLIC_REVENUECAT_API_KEY=appl_TuClavePublicaIOSRevenueCat
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_PRO_ID=card_social_pro
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_PRO_ALIASES=
EXPO_PUBLIC_REVENUECAT_OFFERING_ID=

# --- Closed alpha / tier override (también puede venir de eas.json → env) ---
EXPO_PUBLIC_CLOSED_ALPHA_FULL_TIER=business

# --- Solo desarrollo: NO activar en TestFlight ---
EXPO_PUBLIC_ALLOW_PHOTO_MODERATION_BYPASS=0

# --- [OPT] Si en el futuro movéis Firebase del código a variables Expo (hoy no obligatorio) ---
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyFakeFirebaseWebApiKeyExample01
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=tu-proyecto-firebase
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=G-FAKEXXXXXX
