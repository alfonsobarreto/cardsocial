{
  "cli": {
    "version": ">= 18.6.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true
    },
    "alpha-testflight": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_CLOSED_ALPHA_FULL_TIER": "business"
      }
    }
  },
  "submit": {
    "production": {}
  }
}