{
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-native",
    "allowJs": true,
    "esModuleInterop": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "frontend-web/lib/legalContent.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "services/**/*.ts",
    "services/**/*.tsx",
    "utils/**/*.ts",
    "constants/**/*.ts",
    "types/**/*.ts",
    "scripts/**/*.ts",
    "__tests__/**/*.ts",
    "*.ts",
    "*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "backend/node_modules",
    "**/__tests__/node_modules"
  ],
  "extends": "expo/tsconfig.base",
  "typeRoots": [
    "./node_modules/@types",
    "./frontend-admin"
  ]
}
