rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Business card logos: the owner writes their own; public read (shown in search/market)
    match /business_logos/{uid}/{filename} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Admin-managed assets: public read; any authenticated user can write
    // (the app validates admin role in Firestore before calling uploadBytes)
    match /free-icons/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /premium-icons/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /fonts/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /icons/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /wallpapers/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /assets/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Evidencia visual de denuncias (móvil): el denunciante sube; lectura SDK para super_admin
    // o para el mismo uploader (customMetadata.uploadedBy) para poder generar getDownloadURL.
    // Las URLs con token de descarga siguen siendo capaces de mostrarse en moderación vía JSON cifrado.
    match /vault_evidences/{imageId} {
      allow create: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && request.resource.metadata['uploadedby'] == request.auth.uid;
      allow read: if request.auth != null && request.auth.token.role == 'super_admin';
      allow read: if request.auth != null
        && resource.metadata['uploadedby'] == request.auth.uid;
    }

    // Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
