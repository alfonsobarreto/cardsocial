# =============================================================================
# EXPO FRONTEND — Variables de entorno
# Copia este archivo a .env y llena los valores reales.
# NUNCA commitees .env con valores reales.
# =============================================================================

# URL del backend de moderacion (Azure App Service o local)
# Produccion: https://cardsocial-backend.azurewebsites.net
# Local:      http://192.168.x.x:4000
EXPO_PUBLIC_MODERATION_API_URL=

# Llave de API Gateway para el backend de moderacion
# IMPORTANTE: Esta variable queda VISIBLE en el bundle de la app.
# Usa solo como primera capa — el backend valida JWTs adicionalmente.
EXPO_PUBLIC_MODERATION_GATEWAY_KEY=

# URL base del backend (si es diferente al de moderacion)
EXPO_PUBLIC_BACKEND_BASE_URL=

# Bypass de moderacion para desarrollo local (NO usar en produccion)
# Pon "1" para desarrollo, dejar vacio en produccion
EXPO_PUBLIC_ALLOW_PHOTO_MODERATION_BYPASS=

# Google OAuth (opcional, desactivado en MVP)
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# GitHub OAuth (opcional)
# EXPO_PUBLIC_GITHUB_CLIENT_ID=
